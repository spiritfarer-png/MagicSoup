  dialogues:
  - dialogueText: "\u4F60\u770B\u5230\u4E86\u4E00\u56E2\u718A\u718A\u71C3\u70E7\u7684\u706B\u7130\uFF0C\u5B83\u5728\u5F15\u5BFC\u4F60\u5C06\u98DF\u6750\u6295\u5165\u5176\u4E2D\uFF0C\u4F60\u5FCD\u4E0D\u4F4F\u6C89\u6D78\u5176\u4E2D\u2026."
