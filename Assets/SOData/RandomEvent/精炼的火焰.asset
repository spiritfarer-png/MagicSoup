    - optionText: "\u5C06\u98DF\u6750\u6295\u5165"
      isFinalOption: 0
      isGetReward: 0
      nextDialogueIndex: 1
    - optionText: "\u8FDC\u79BB\u706B\u7130"
      isFinalOption: 0
      isGetReward: 0
      nextDialogueIndex: 2
  - dialogueText: "\u4F60\u5C06\u98DF\u6750\u6295\u5165\uFF0C\u706B\u5806\u5C06\u98DF\u7269\u5305\u88F9\uFF0C\u71C3\u70E7\u2026\u7136\u540E\u5410\u51FA\u4E86\u4E24\u4EFD\u66F4\u7CBE\u70BC\u7684\u98DF\u7269\uFF1B<br>\u4F60\u6EE1\u8F7D\u800C\u5F52\u3002"
    options:
    - optionText: "\u79BB\u5F00"
      isFinalOption: 1
      isGetReward: 1
      nextDialogueIndex: 0
  - dialogueText: "\u5FEB\u8D70\uFF01\u4F60\u8FDC\u79BB\u4E86\u8FD9\u56E2\u8BE1\u5F02\u7684\u706B\u7130\uFF0C\u56DE\u5934\u671B\u53BB\uFF0C\u4F60\u4ECD\u5FC3\u6709\u4F59\u60B8\u3002"
