  dialogues:
  - dialogueText: "\u4F60\u770B\u5230\u4E86\u4E00\u5904\u2026\u2026\u53A8\u623F\u9057\u5740\uFF1F\uFF01\u5185\u90E8\u5DF2\u7ECF\u7834\u8D25\u4E0D\u582A<br>\u4F46\u6216\u8BB8\u8FD8\u6709\u70B9\u4E1C\u897F"
