      isFinalOption: 0
      isGetReward: 0
      nextDialogueIndex: 1
    - optionText: "\u8D70\u4E86<br>\u591A\u4E00\u4E8B\u4E0D\u5982\u5C11\u4E00\u4E8B "
      isFinalOption: 0
      isGetReward: 0
      nextDialogueIndex: 2
  - dialogueText: "\u4F60\u5728\u5185\u90E8\u641C\u522E\u4E86\u534A\u5929<br>\u6700\u7EC8\u5728\u4E00\u51FA\u6807\u8BB0\u8FD9\u4E00\u5904\u5371\u9669\u54C1\u7684\xB7\u67DC\u5B50\u91CC\u627E\u5230\u4E86\u4E00\u74F6\u2026\u8C03\u6599\uFF1F\uFF01"
